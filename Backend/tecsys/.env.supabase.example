# Copie para `.env.supabase` (mesma pasta, NUNCA commitar) e preencha
# com a connection string do Supabase. Usado por scripts/run-backend.sh
# com `--db supabase`.
#
# Formato aceito: postgres://usuario:senha@host:5432/banco
# (o script converte sozinho para o formato JDBC que o Spring exige).
SUPABASE_DB_URL=postgres://postgres.SEU_USER:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
