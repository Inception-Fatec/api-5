DB_URL=jdbc:postgresql://localhost:5432/tecsys
DB_USER=seu_usuario_local
DB_PASSWORD=sua_senha_local

# TG-94: segredo obrigatório para assinatura dos tokens JWT.
# Gere com: openssl rand -hex 32
# Nunca utilize um segredo padrão ou compartilhe sua chave.
# Configure API_SECURITY_TOKEN_SECRET no ambiente de execução.

# URL do motor de decisão (opcional; padrão http://localhost:8082/api/calculate)
ENGINE_URL=http://localhost:8082/api/calculate

# TG-118: configurações do ETL (todas opcionais; lidas por etl.* no application.yml).
# Executável do Python que roda o etl_cli.py (padrão: python).
# Use o python do ambiente virtual, ex.: /caminho/api-5/modules/.venv/bin/python
#ETL_PYTHON=python
# Caminho do etl_cli.py (padrão: ../api-5/modules/etl_cli.py, relativo à pasta do backend).
#ETL_SCRIPT_PATH=../api-5/modules/etl_cli.py
# Tempo máximo de uma carga, em minutos (padrão: 120).
#ETL_TIMEOUT_MINUTES=120
