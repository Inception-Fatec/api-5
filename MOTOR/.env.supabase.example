# Copie para `.env.supabase` (mesma pasta, NUNCA commitar) e preencha
# com a connection string do Supabase. Usado por scripts/run-motor.sh
# com `--db supabase`. O relevo usa AWS Copernicus GLO-30, sem chave.
#
# Formato aceito: postgres:// ou postgresql:// (o jeito que o Supabase
# mostra no dashboard), ex: postgresql://usuario:senha@host:5432/banco
# (o script converte sozinho para o formato JDBC que o Spring exige).
SUPABASE_DB_URL=postgres://postgres.SEU_USER:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Mirror local/NAS opcional (caminho no host; o run-motor.sh monta read-only):
# DEM_MIRROR_DIR=/mnt/tecsys-dem-mirror
